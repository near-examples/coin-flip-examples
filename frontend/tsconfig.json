{
  "compilerOptions": {
    "baseUrl": "src",        // Set baseUrl to src for simpler imports
    "paths": {
      "@/*": ["*"]           // Now @/components/... points to src/components/...
    },
    "jsx": "preserve",
    "strict": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "global.d.ts"
  ],
  "exclude": ["node_modules"]
}
